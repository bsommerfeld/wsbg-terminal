<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.bsommerfeld</groupId>
        <artifactId>wsbg-terminal-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tinyunlock</artifactId>

    <name>TinyUnlock</name>
    <description>Opens one page in embedded Chromium and hands its cookies to TinyFetch - runs as a child process</description>

    <!-- Deliberately NOT a Java module: its headless browser has to live in
         org.cef.browser (CefBrowser_N is package-private), a package the
         jcef-api jar owns too. It only ever runs in its own child JVM on the
         class path; the application never loads it. -->

    <properties>
        <!-- Chromium 132, the engine the terminal's JCEF runs. Browser.CHROMIUM_EMBEDDED
             in TinyFetch describes exactly this build - bump both together. -->
        <jcefmaven.version>132.3.1</jcefmaven.version>
        <!-- The child JVM may be an older runtime than the application's. -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>${jcefmaven.version}</version>
            <!-- JOGL and GlueGen serve JCEF's own OpenGL windowless browser,
                 which the engine never creates (HeadlessCefBrowser draws
                 nothing; the visible window is a windowed browser). Left
                 out, the engine is several MB and a set of jar-embedded
                 natives smaller - natives macOS would want signed. -->
            <exclusions>
                <exclusion>
                    <groupId>me.friwi</groupId>
                    <artifactId>jogl-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>me.friwi</groupId>
                    <artifactId>gluegen-rt</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- target/engine/ holds every jar the child JVM needs besides
                 this module's own classes - the directory a caller puts on
                 the child's class path. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>engine-classpath</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/engine</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
