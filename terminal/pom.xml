<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>wsbg-terminal</artifactId>
        <groupId>de.bsommerfeld</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>terminal</artifactId>

    <dependencies>

        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>reddit</artifactId>
        </dependency>
        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>agent</artifactId>
        </dependency>
        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>database</artifactId>
        </dependency>
        <!-- The web world: web-api carries the contracts (fetch seam, sources,
             gateway, facts), web-impl the machinery and every source. The
             forty per-source dependencies of the old world are gone. -->
        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>web-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.bsommerfeld</groupId>
            <artifactId>web-impl</artifactId>
        </dependency>

        <!-- JCEF (embedded Chromium) + WebSocket push.
             No JavaFX in this module — the terminal UI is HTML/CSS/JS. -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <!-- jcefmaven pulls JOGL/GlueGen transitively for jcef's stock
                 GLCanvas-based OSR browser (CefBrowserOsr). We never use that
                 path — our SwingCefBrowser does software OSR with zero OpenGL
                 — so JOGL is never class-loaded and its (x86_64-only) natives
                 are never dlopen'd. Left as-is; the transitive jars are dead
                 weight, not a runtime hazard. -->
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
        </dependency>

        <!-- Native window chrome on Windows: DWM dark title bar via dwmapi.
             No-op / unused on macOS (native NSWindow) and Linux. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>

        <dependency>
            <groupId>de.bsommerfeld.jshepherd</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.bsommerfeld.jshepherd</groupId>
            <artifactId>toml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- The web/_preview*.html files are local design prototypes: they
                 stay in the working tree, but must never be packaged - the
                 AssetServer would serve them by URL and they still show
                 widgets that no longer exist. -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>web/_preview*.html</exclude>
                    <!-- The debug-dashboard assets are NOT excluded here on
                         purpose. A resource exclusion keeps a file out of
                         target/classes, and target/classes is exactly what the
                         AssetServer serves in a developer run - so excluding
                         them here removed the console from the only build that
                         is allowed to have it, while the packaging test went on
                         passing because the JAR was indeed clean. They are
                         stripped at the JAR step instead (maven-jar-plugin
                         below), which is the step that decides what ships. -->
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Embeds Main-Class in the JAR manifest so the launcher's
                 resolveMainClass() scan finds the entry point automatically. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>de.bsommerfeld.wsbg.terminal.ui.AppMain</mainClass>
                        </manifest>
                    </archive>
                    <!-- Debug-dashboard assets (reserved paths; see the
                         DebugBridge Javadoc): they belong in target/classes so
                         a developer run can serve them, and NEVER in the JAR.
                         Stripped here, at the step that decides what ships -
                         UNCONDITIONAL on purpose, with no Maven profile a
                         build path could forget. DebugPackagingTest nails it. -->
                    <excludes>
                        <exclude>web/debug*.html</exclude>
                        <exclude>web/debug/**</exclude>
                        <exclude>web/js/debug/**</exclude>
                        <exclude>web/css/debug*.css</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- exec:exec (not exec:java) is required because JCEF on macOS
                 reaches into sun.lwawt internals, which need add-opens
                 flags at JVM startup. exec:java reuses Maven's JVM and
                 can't apply those; exec:exec forks a clean process. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <!-- Metal stays ON: the OpenGL fallback makes every
                             full-window OSR blit ~15ms on the EDT (grid-view
                             slideshow). The Metal Queue-Flusher SIGSEGV on a
                             display change is handled in-app by GraphicsConfigPin,
                             not by switching pipelines; WSBG_J2D_OPENGL=true stays
                             as the escape hatch (see AppMain). -->
                        <!-- GC: mirrors AppLauncher.addGcFlags in the launcher
                             module — keep the two lists in sync, or a jank fix
                             validated in dev silently misses the shipped app.
                             ZGC because a G1 young pause is a skipped frame on
                             the EDT; -Xmx4g so the heap never competes with the
                             resident Ollama model for RAM. -->
                        <argument>-XX:+UseZGC</argument>
                        <argument>-Xmx4g</argument>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                        <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                        <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                        <argument>--add-opens=java.desktop/java.awt.peer=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>de.bsommerfeld.wsbg.terminal.ui.AppMain</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
